{
  "name": "arena-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../tests/tsconfig.json && tsc --noEmit -p ../packages/domain/tsconfig.json && tsc --noEmit -p ../packages/contracts/tsconfig.json && tsc --noEmit -p ../mcp/tsconfig.json",
    "test": "node --experimental-strip-types --test ../tests/*.test.ts ../packages/domain/test/*.test.ts ../packages/contracts/test/*.test.ts ../mcp/test/*.test.ts"
  },
  "dependencies": {
    "next": "^15.5.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
